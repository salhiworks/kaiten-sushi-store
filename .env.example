# Copy this file to .env.local and fill it in. Never commit .env.local (Git ignores it).
# These values are built into the site: after changing one, restart `npm run dev` or rebuild.

# "live" = your menu, opening hours and pickup orders come from Supabase, and the admin works.
# Anything else, or unset = demo store: built-in menu, no database, ordering off, no admin.
KAITEN_MODE=demo

# Your Supabase project (dashboard → Connect, or Project Settings → API Keys). Needed for live mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Only `npm run admin:create` uses it, on your own computer; the store never reads it.
# Never add it to a hosting provider or the public demo.
SUPABASE_SECRET_KEY=
